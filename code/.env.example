# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会被提交。

# 必填：模型 API Key（智谱开放平台 https://open.bigmodel.cn 控制台获取）
LLM_API_KEY=

# 可选：OpenAI 兼容接口地址
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4   （默认，免费档 glm-4.5-flash）
# DeepSeek:  https://api.deepseek.com/v1
# Ollama:    http://localhost:11434/v1              （此时 Key 随便填，如 ollama）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选：模型名
# glm-4.5-flash 是智谱的免费档，支持工具调用；上级模型为 glm-4.5（收费）
LLM_MODEL=glm-4.5-flash

# 可选：Agent 最大工具调用轮次
AGENT_MAX_STEPS=5
